# Copy to server/.env (or run `npm run vapid`, which creates it).

# Web Push (VAPID). Generate with `npm run vapid`. Changing the keys
# invalidates every existing push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto: or https: URL you control.
VAPID_SUBJECT=mailto:changeme@example.com

# HTTP port.
PORT=3000

# Optional. Secret that signs booking tokens. If empty, one is generated
# and stored in storage/booking-secret on first start.
BOOKING_SECRET=

# Optional. Where the SQLite database lives (default: ./storage).
DATA_DIR=

# Optional. Set behind a reverse proxy (e.g. "1" or "loopback") so rate
# limiting sees the real client IP.
TRUST_PROXY=
