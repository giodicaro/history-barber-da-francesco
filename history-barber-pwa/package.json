{
  "name": "history-barber-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "History Barber: installable PWA with online booking, offline queue and Web Push reminders",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "vapid": "node scripts/generate-vapid.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "push:test": "node scripts/push-test.mjs",
    "test": "node --test --test-reporter=spec \"test/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
