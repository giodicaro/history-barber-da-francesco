# Variabili d'ambiente di History Barber.
# Copia questo file in .env.local (che git ignora) e riempi i valori.
# Su Vercel: Settings → Environment Variables, stessi nomi.
# Senza nessuna di queste variabili il sito funziona lo stesso, ma le
# prenotazioni restano in memoria, l'agenda non è raggiungibile e nessuno
# riceve gli avvisi.

# ── Database delle prenotazioni ──────────────────────────────────────────
# Postgres di qualsiasi fornitore (Neon, Supabase, Vercel Marketplace...).
# Usa la stringa "pooled" se il fornitore ne offre una: su serverless conta.
# Applica lo schema una volta sola con: npm run db:init
# Senza questa variabile:
#   - in locale l'agenda usa un Postgres su file in .data/agenda (PGlite),
#     creato da solo: i dati restano fra un riavvio e l'altro;
#   - su Vercel resta in memoria e si azzera.
# In locale, quindi, puoi lasciarla commentata.
# DATABASE_URL="postgres://utente:password@host/database?sslmode=require"

# ── Accesso all'agenda /admin (Auth.js) ──────────────────────────────────
# Chiave con cui si firmano i cookie di sessione. Generala così:
#   npx auth secret        (oppure: openssl rand -base64 32)
AUTH_SECRET="una-stringa-casuale-lunga"
# Password unica per entrare in /admin. Cambiala prima di usarla davvero.
ADMIN_PASSWORD="scegli-una-password-lunga"
# Solo se il sito gira su un dominio diverso da quello di Vercel:
# AUTH_URL="https://www.historybarber.it"

# ── Avviso al titolare su Telegram ───────────────────────────────────────
# 1. su Telegram scrivi a @BotFather → /newbot → copia il token
# 2. manda un messaggio qualsiasi al bot dall'account di Francesco
# 3. apri https://api.telegram.org/bot<TOKEN>/getUpdates e copia "chat":{"id":...}
# Senza queste due variabili l'avviso finisce solo nei log del server.
TELEGRAM_BOT_TOKEN="123456789:AA..."
TELEGRAM_CHAT_ID="123456789"
